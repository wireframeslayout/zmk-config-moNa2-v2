#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100
#define MOUSE 7
#define SCROLL 8

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <300>;
    flavor = "balanced";
};

/ {
    combos {
        compatible = "zmk,combos";

        LeftBlacket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <17 18>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        RightBlacket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <29 30>;
        };

        LeftPar {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <18 19>;
        };

        RightPar {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <30 31>;
        };

        Equal {
            bindings = <&kp EQUAL>;
            key-positions = <17 7>;
        };

        quote {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <13 17>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        mkp_to_layer_0: mkp_to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to1 &mkp MACRO_PLACEHOLDER &to 0>;
            label = "MKP_TO_LAYER_0";
        };

        alt_mo6: alt_mo6 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&mo 6 &kp LALT>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mo 6 &kp LALT>;

            label = "ALT_MO6";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        alt_layer_ht: alt_layer_ht {
            compatible = "zmk,behavior-hold-tap";
            label = "ALT_LAYER_HT";
            bindings = <&alt_mo6>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
        };

        scroll_up_down: mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        scroll_right_left: mouse_wheel_right_left {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W         &kp E                     &kp R        &kp T                                          &kp Y        &kp U  &kp I      &kp O    &lt 8 P
&lt 5 A           &kp S         &kp D                     &kp F        &kp G                               &kp MINUS  &kp H        &kp J  &kp K      &kp L    &kp BACKSPACE
&mt LEFT_SHIFT Z  &kp X         &kp C                     &kp V        &kp B             &kp LEFT_SHIFT    &kp RCTRL  &kp N        &kp M  &kp COMMA  &kp DOT  &kp ENTER
&kp LCTRL         &kp LEFT_WIN  &alt_layer_ht 0 LEFT_ALT  &lt 1 LANG2  &lt 1 LANGUAGE_2  &kp SPACE         &kp SPACE  &lt 2 LANG1                             &lt 3 SLASH
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_2 {
            bindings = <
&kp ESC         &kp LS(EXCL)  &kp LS(AT)         &kp LS(POUND)  &kp LS(DLLR)                                     &kp LS(PRCNT)  &kp LS(CARET)  &kp LS(AMPS)  &kp LS(STAR)  &kp GRAVE
&kp TAB         &kp TILDE     &kp DOUBLE_QUOTES  &kp SQT        &kp NON_US_BACKSLASH               &trans        &kp LEFT       &kp DOWN       &kp UP_ARROW  &kp RIGHT     &kp SEMICOLON
&kp LEFT_SHIFT  &trans        &trans             &trans         &mkp LCLK             &mkp RCLK    &trans        &trans         &trans         &trans        &trans        &trans
&trans          &trans        &trans             &trans         &trans                &trans       &kp LEFT_GUI  &trans                                                    &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_1 {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 4  &bt BT_DISC 0  &kp SLASH      &kp PLUS                            &kp N7        &kp N8        &kp N9        &trans  &kp GRAVE
&bt BT_SEL 1  &trans        &bt BT_DISC 1  &kp PERIOD     &kp MINUS                   &trans  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &trans  &kp BACKSPACE
&bt BT_SEL 2  &trans        &bt BT_DISC 2  &trans         &kp ASTERISK  &trans        &kp N0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &kp RETURN
&bt BT_SEL 3  &trans        &bt BT_DISC 3  &bt BT_DISC 4  &trans        &bt BT_CLR    &trans  &trans                                            &trans
            >;

            sensor-bindings = <&scroll_right_left>;
        };

        layer_3 {
            bindings = <
&kp F1   &kp F2   &kp F3   &kp F4  &kp F5                     &trans  &trans    &kp UP_ARROW  &trans  &trans
&kp F6   &kp F7   &kp F8   &kp F9  &kp F10            &trans  &trans  &kp LEFT  &kp RIGHT     &trans  &kp DELETE
&kp F10  &kp F11  &kp F12  &trans  &trans   &trans    &trans  &trans  &trans    &kp DOWN      &trans  &trans
&trans   &trans   &trans   &trans  &trans   &trans    &trans  &trans                                  &trans
            >;
        };

        layer_4 {
            bindings = <
&kp ESCAPE  &kp LC(LS(TAB))     &kp PRINTSCREEN         &kp LC(TAB)              &trans                                     &trans  &trans      &trans       &trans         &trans
&kp TAB     &kp LG(LEFT_ARROW)  &kp LG(RIGHT_ARROW)     &kp LC(LG(LEFT_ARROW))   &kp LC(LG(RIGHT_ARROW))            &trans  &trans  &trans      &trans       &trans         &trans
&trans      &kp LEFT_SHIFT      &kp LG(LS(LEFT_ARROW))  &kp LG(LS(RIGHT_ARROW))  &trans                   &trans    &trans  &trans  &kp DELETE  &kp PAGE_UP  &kp PAGE_DOWN  &trans
&trans      &trans              &trans                  &trans                   &trans                   &trans    &trans  &trans                                          &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        layer_5 {
            bindings = <
&trans     &kp LC(W)  &kp LC(E)  &kp LC(R)  &kp LC(T)                       &kp LC(Y)  &kp LC(U)  &kp LC(I)      &kp LC(O)    &kp LC(P)
&trans     &kp LC(A)  &kp LC(S)  &kp LC(D)  &kp LC(F)               &trans  &kp LC(H)  &kp LC(J)  &kp LC(K)      &kp LC(L)    &kp LC(BACKSPACE)
&kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp LC(B)  &kp LC(G)    &trans  &kp LC(N)  &kp LC(M)  &kp LC(COMMA)  &kp LC(DOT)  &kp LC(ENTER)
&trans     &trans     &trans     &trans     &trans     &trans       &trans  &trans                                            &trans
            >;
        };

        layer_6 {
            bindings = <
&trans   &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&kp TAB  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans   &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans   &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans                  &trans                                         &trans                  &trans     &trans               &trans  &trans
&trans  &trans  &trans  &mkp MB4                &mkp MB5                               &trans  &trans                  &trans     &mkp_to_layer_0 MB2  &trans  &trans
&trans  &trans  &trans  &trans                  &trans                       &trans    &trans  &trans                  &mkp LCLK  &trans               &trans  &trans
&trans  &trans  &trans  &lt_to_layer_0 1 LANG2  &lt_to_layer_0 1 LANGUAGE_2  &trans    &trans  &lt_to_layer_0 2 LANG1                                          &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };
    };
};
